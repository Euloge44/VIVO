# Configuration Django
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,yourdomain.com

# Base de données
# Développement (SQLite)
DATABASE_URL=sqlite:///db.sqlite3
# Production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/gourmetguide

# Redis (pour cache et Django Channels)
REDIS_URL=redis://localhost:6379/0

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Stripe (Paiements)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Paiements mobiles (simulation)
TMONEY_API_KEY=demo_tmoney_key
FLOOZ_API_KEY=demo_flooz_key

# Configuration Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Pour production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@gourmetguide.com

# Sécurité (Production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Django Allauth (Optionnel)
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_SECRET=your-google-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_SECRET=your-facebook-secret

# Cloudinary (Optionnel pour stockage d'images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Celery (Tâches asynchrones)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/gourmetguide.log

# Monitoring (Optionnel)
SENTRY_DSN=your-sentry-dsn

# Langue par défaut
LANGUAGE_CODE=fr
TIME_ZONE=Africa/Lome